# Server Configuration
PORT=4000
NODE_ENV=development
LOG_HASH_SECRET=replace-with-a-long-random-secret
# Такое же значение задаётся Nuxt как NUXT_REQUEST_ID_FORWARD_SECRET.
REQUEST_ID_FORWARD_SECRET=replace-with-another-long-random-secret

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL="postgresql://altera:altera@localhost:25432/altera"
DATABASE_URL_UNPOOLED="postgresql://altera:altera@localhost:25432/altera"

# Redis Configuration
REDIS_URL=redis://localhost:26379
CACHE_TTL=21600

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-here

# Magic Link Configuration
MAGIC_LINK_EXPIRY_MINUTES=15
MAGIC_LINK_BASE_URL=http://localhost:3000/auth/verify

# Mail (T-021): smtp | console | fake. Вне production без значения — console (письмо не доставляется).
# В production значение обязательно: без него отправка падает с PROVIDER_UNAVAILABLE: mail.
# Локальный приёмник — Mailpit из docker-compose.yml, веб-интерфейс http://localhost:28025.
MAIL_TRANSPORT=smtp
MAIL_FROM="Altera <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=21025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Storage (T-062): local | s3. Вне production без значения — local: объекты в STORAGE_LOCAL_DIR,
# сервер раздаёт их по /media/*. В production значение обязательно: без него операции хранилища
# падают с PROVIDER_UNAVAILABLE: storage; local в production запрещён. Провайдер S3 — Q-01.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_MEDIA_BASE_URL=http://localhost:4000/media
STORAGE_SIGNING_SECRET=replace-with-a-long-random-secret
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Сборщик ошибок (T-089): адаптер внешнего сборщика. Поставщик — Q-01, пока только noop;
# история backend.error пишется в базу при любом значении.
ERROR_COLLECTOR_DRIVER=noop

# Security Configuration
JWT_ACCESS_TOKEN_EXPIRY=15m
