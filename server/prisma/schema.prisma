/// Поток истории ошибок: сбои бэкенда и отдельная вкладка ошибок фронта `page.error`
/// (`80-observability/error-collector.md` §2 п. 1).
enum ErrorStream {
  backend
  page
}

/// Неизменяемая история `backend.error` (#81, `error-collector.md` §2 п. 2): запись не
/// редактируется — UPDATE запрещён триггером. Рабочие статусы групп ведутся отдельно (T-081).
/// Идентификатора пользователя нет намеренно (§2 п. 8): мост к обращению — только `requestId`.
model BackendErrorEvent {
  id         String      @id @default(uuid())
  /// Событие-источник: `error.unhandled`, `backend.error`, `job.failed` или `page.error`.
  event      String
  stream     ErrorStream
  /// `api`, `web` или `worker`.
  service    String
  code       String
  /// Маршрут по шаблону или вид задания — без значений параметров (§2 п. 5).
  route      String?
  requestId  String?
  jobId      String?
  errorType  String?
  message    String?     @db.Text
  /// Стек после маскирования ПДн.
  stack      String?     @db.Text
  /// Сигнатура группы: сервис, код, маршрут и первые кадры стека без адресов (§2 п. 3).
  signature  String
  occurredAt DateTime    @default(now())

  @@index([signature, occurredAt])
  @@index([stream, occurredAt])
  @@index([requestId])
  @@map("backend_error_events")
}

/// Вид резервной копии (`85-media-and-binary/backups.md` п. 1–2): база — управляемый PostgreSQL и
/// еженедельный `pg_dump`; медиа — версионирование бакета и еженедельная синхронизация во второй.
enum BackupKind {
  database
  media
}

enum BackupRunStatus {
  succeeded
  failed
}

/// Отметка прогона резервного копирования. Копии делает эксплуатация вне продукта; продукт только
/// читает отметки, чтобы показать возраст последней успешной копии в состоянии системы
/// (`80-observability/health-and-alerts.md` п. 1, журнал §29.9) и оповестить о просрочке.
/// Задание копирования ставит отметку командой `server/scripts/record-backup.ts`.
/// Ни путей, ни адресов бакетов, ни учётных данных здесь нет: `detail` — короткая техническая
/// пометка вида числа объектов или класса отказа.
model BackupRun {
  id          String          @id @default(uuid())
  kind        BackupKind
  status      BackupRunStatus
  /// Момент завершения прогона по данным эксплуатации, а не время записи отметки.
  completedAt DateTime
  /// Чем сделана копия: `managed-postgres`, `pg_dump`, `bucket-sync` и подобное.
  source      String
  detail      String?
  createdAt   DateTime        @default(now())

  @@index([kind, status, completedAt])
  @@map("backup_runs")
}
