generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                          String                        @id @default(uuid())
  name                        String
  pendingName                 String?
  email                       String                        @unique
  bio                         String?
  photoUrl                    String?
  role                        Role                          @default(reader)
  handle                      String                        @unique
  locale                      Locale                        @default(ru)
  avatarAssetId               String?
  prevAvatarId                String?
  nameCheckStatus             ProfileCheckStatus            @default(ok)
  avatarCheckStatus           ProfileCheckStatus            @default(ok)
  socialLinks                 Json?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  archivedAt                  DateTime?
  archiveMode                 AccountArchiveMode?
  archivedByActorId           String?
  archivedByRole              Role?
  archiveReason               String?
  /// Категория причины административной блокировки — одна из четырёх базовых (журнал §38 п. 1).
  /// У самостоятельного архива её нет: пользователь себе причину не выбирает.
  archiveReasonCategory       AccountArchiveReasonCategory?
  /// Короткое объяснение для экрана и письма пользователю (§26.9); внутренняя причина остаётся
  /// в `archiveReason` и наружу не уходит.
  archivePublicMessage        String?
  isServiceAccount            Boolean                       @default(false)
  planTier                    PlanTier                      @default(free)
  planUntil                   DateTime?
  /// Пароль хранится PHC-строкой Argon2id; `null` — аккаунт без пароля, он входит по ссылке
  /// (журнал §34 п. 8).
  passwordHash                String?
  passwordUpdatedAt           DateTime?
  /// Когда адрес подтверждён: вход по ссылке подтверждает его сам, регистрация с паролем —
  /// письмом до первого входа (журнал §34 п. 7).
  emailVerifiedAt             DateTime?
  articles                    Article[]
  bookmarks                   Bookmark[]
  planGrants                  PlanGrant[]                   @relation("PlanGrantRecipient")
  grantedPlanGrants           PlanGrant[]                   @relation("PlanGrantActor")
  permissionExceptions        PermissionException[]         @relation("PermissionExceptionRecipient")
  grantedPermissionExceptions PermissionException[]         @relation("PermissionExceptionGrantActor")
  revokedPermissionExceptions PermissionException[]         @relation("PermissionExceptionRevokeActor")
  sessions                    Session[]
  emailChangeRequest          EmailChangeRequest?
  accountArchiveRequest       AccountArchiveRequest?
  accountAppealToken          AccountAppealToken?
  accountAppeal               AccountAppeal?
  currentHandle               HandleHistory                 @relation("CurrentUserHandle", fields: [handle], references: [handle], onDelete: Restrict, onUpdate: Restrict)
  handleHistory               HandleHistory[]               @relation("HandleOwner")
  createdTags                 Tag[]                         @relation("TagCreator")
  legalConsents               UserLegalConsent[]
  translatedArticles          ArticleTranslation[]          @relation("ArticleTranslator")
  articleRevisions            ArticleRevision[]             @relation("ArticleRevisionCreator")
  ownedMediaAssets            MediaAsset[]                  @relation("MediaAssetOwner")
  avatarAsset                 MediaAsset?                   @relation("CurrentAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  previousAvatar              MediaAsset?                   @relation("PreviousAvatar", fields: [prevAvatarId], references: [id], onDelete: SetNull)
  reviewNotes                 ReviewNote[]                  @relation("ReviewNoteCreator")
  supportRequests             SupportRequest[]
  answeredSupportRequests     SupportRequest[]              @relation("SupportRequestAnswer")
  accountExports              AccountExport[]

  @@unique([id, role, isServiceAccount])
  @@index([nameCheckStatus])
  @@index([avatarCheckStatus])
  @@map("users")
}

/// Append-only registry: issued handles are never deleted or reused.
model HandleHistory {
  handle      String   @id
  userId      String?
  user        User?    @relation("HandleOwner", fields: [userId], references: [id], onDelete: SetNull)
  currentUser User?    @relation("CurrentUserHandle")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("handle_history")
}

/// Токен входа привязан к адресу, а не к учётной записи: первый вход создаёт аккаунт
/// при подтверждении ссылки (docs/spec/50-access/session-lifecycle.md п. 2), поэтому
/// на момент запроса ссылки пользователя ещё может не быть.
model MagicLinkToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique @db.VarChar(64)
  email          String    @unique
  locale         Locale    @default(ru)
  next           String?
  termsVersion   Int?
  privacyVersion Int?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@map("magic_link_tokens")
}

/// Одно обращение на аккаунт: уникальность `userId` одновременно фиксирует продуктовое правило
/// и закрывает гонку двух отправок формы (`blocked-appeal.md` §4, журнал #48).
model AccountAppeal {
  id               String                       @id @default(uuid())
  userId           String                       @unique
  user             User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  message          String                       @db.VarChar(2000)
  status           AccountAppealStatus          @default(submitted)
  submittedAt      DateTime                     @default(now())
  decidedAt        DateTime?
  decidedByActorId String?
  decidedByRole    Role?
  decisionReason   String?
  /// Снимок публичных данных блокировки нужен и после восстановления, когда поля `User`
  /// очищены: старая ссылка всё ещё показывает итог решения без внутренних деталей.
  archivedAt       DateTime
  reasonCategory   AccountArchiveReasonCategory
  staffMessage     String?
  planTier         PlanTier
  planUntil        DateTime?

  @@index([status, submittedAt])
  @@map("account_appeals")
}

model AccountAppealToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("account_appeal_tokens")
}

/// Одноразовые токены ветки пароля (T-115, журнал §34 п. 7): подтверждение адреса после
/// регистрации с паролем и сброс забытого пароля. Токен привязан к адресу и виду действия —
/// повторный запрос того же вида отзывает прежний токен, как это делает ссылка входа.
model PasswordToken {
  id        String               @id @default(cuid())
  tokenHash String               @unique @db.VarChar(64)
  email     String
  purpose   PasswordTokenPurpose
  locale    Locale               @default(ru)
  next      String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@unique([email, purpose])
  @@map("password_tokens")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @db.VarChar(64)
  previousTokenHash String?   @db.VarChar(64)
  expiresAt         DateTime
  revokedAt         DateTime?
  userAgent         String?
  ip                String?
  /// Ограниченная сессия самостоятельно архивированного аккаунта: доступен только экран
  /// состояния /me/archived (docs/spec/50-access/session-lifecycle.md п. 7).
  limited           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  @@index([userId])
  @@index([previousTokenHash])
  @@map("sessions")
}

model EmailChangeRequest {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  codeHash  String   @db.VarChar(64)
  expiresAt DateTime
  /// Израсходованные попытки ввода кода: по их исчерпании запрос закрывается
  /// (`30-account/reader/email-change.md` §4).
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("email_change_requests")
}

/// Открытый запрос самостоятельного архивирования аккаунта: письмо с одноразовой ссылкой уже
/// ушло, а архив выполняет переход по ней (`30-account/reader/delete-account.md` §4). Запрос
/// один на аккаунт: второй адрес подтверждения отвечал бы `CONFLICT`.
model AccountArchiveRequest {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("account_archive_requests")
}

model Section {
  id                    String               @id @default(uuid())
  name                  String
  nameEn                String?
  slug                  String               @unique
  description           String?
  descriptionEn         String?
  seoTitle              String?
  seoTitleEn            String?
  seoDescription        String?
  seoDescriptionEn      String?
  order                 Int
  status                TaxonomyStatus       @default(active)
  successorId           String?
  archivedAt            DateTime?
  archivedByActorId     String?
  archivedByRole        Role?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  articles              Article[]
  successor             Section?             @relation("SectionSuccessor", fields: [successorId], references: [id], onDelete: Restrict)
  predecessors          Section[]            @relation("SectionSuccessor")
  currentSlug           SectionSlugHistory   @relation("CurrentSectionSlug", fields: [slug], references: [slug], onDelete: Restrict, onUpdate: Restrict)
  slugHistory           SectionSlugHistory[] @relation("SectionSlugOwner")
  redirectedSlugHistory SectionSlugHistory[] @relation("SectionSlugRedirect")

  @@index([status, order])
  @@index([successorId])
  @@map("sections")
}

/// Append-only registry: issued section slugs are never deleted or reused.
model SectionSlugHistory {
  slug                String   @id
  ownerSectionId      String?
  redirectToSectionId String?
  createdAt           DateTime @default(now())
  ownerSection        Section? @relation("SectionSlugOwner", fields: [ownerSectionId], references: [id], onDelete: SetNull)
  redirectToSection   Section? @relation("SectionSlugRedirect", fields: [redirectToSectionId], references: [id], onDelete: SetNull)
  currentSection      Section? @relation("CurrentSectionSlug")

  @@index([ownerSectionId])
  @@index([redirectToSectionId])
  @@map("section_slug_history")
}

model Format {
  id            String         @id @default(uuid())
  name          String
  nameEn        String?
  slug          String         @unique
  description   String?
  descriptionEn String?
  status        TaxonomyStatus @default(active)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  articles      Article[]

  @@index([status])
  @@map("formats")
}

model Tag {
  id                    String           @id @default(uuid())
  name                  String
  nameEn                String?
  slug                  String           @unique
  description           String?
  status                TaxonomyStatus   @default(active)
  mergedIntoId          String?
  createdByActorId      String?
  createdByRole         Role?
  archivedAt            DateTime?
  archivedByActorId     String?
  archivedByRole        Role?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  articles              Article[]        @relation("ArticleToTag")
  creator               User?            @relation("TagCreator", fields: [createdByActorId], references: [id], onDelete: SetNull)
  mergedInto            Tag?             @relation("TagMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom            Tag[]            @relation("TagMerge")
  currentSlug           TagSlugHistory   @relation("CurrentTagSlug", fields: [slug], references: [slug], onDelete: Restrict, onUpdate: Restrict)
  slugHistory           TagSlugHistory[] @relation("TagSlugOwner")
  redirectedSlugHistory TagSlugHistory[] @relation("TagSlugRedirect")

  @@index([status])
  @@index([mergedIntoId])
  @@index([createdByActorId])
  @@map("tags")
}

/// Append-only registry: issued tag slugs are never deleted or reused.
model TagSlugHistory {
  slug            String   @id
  ownerTagId      String?
  redirectToTagId String?
  createdAt       DateTime @default(now())
  ownerTag        Tag?     @relation("TagSlugOwner", fields: [ownerTagId], references: [id], onDelete: SetNull)
  redirectToTag   Tag?     @relation("TagSlugRedirect", fields: [redirectToTagId], references: [id], onDelete: SetNull)
  currentTag      Tag?     @relation("CurrentTagSlug")

  @@index([ownerTagId])
  @@index([redirectToTagId])
  @@map("tag_slug_history")
}

model Article {
  id                String               @id @default(uuid())
  // T-020 сконвертировала тела в документ `content`: `ArticleTranslation.body` и
  // `ArticleRevision.body` хранят документ, а не JSON-строку. Старые локализованные поля
  // и trigger `t015_sync_legacy_article` остаются до перевода API на языковые версии:
  // действующие резолверы всё ещё читают и пишут `articles.body` как строку.
  title             String
  slug              String               @unique
  dek               String?
  body              String
  excerpt           String?
  featuredImage     String?
  status            ArticleStatus        @default(draft)
  publishedAt       DateTime?
  sourceLocale      Locale               @default(ru)
  isEditorial       Boolean              @default(false)
  firstPublishedAt  DateTime?
  archivedAt        DateTime?
  archivedByActorId String?
  archivedByRole    Role?
  archiveReason     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  authorId          String
  sectionId         String?
  formatId          String?
  coverAssetId      String?
  author            User                 @relation(fields: [authorId], references: [id])
  section           Section?             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  format            Format?              @relation(fields: [formatId], references: [id], onDelete: SetNull)
  coverAsset        MediaAsset?          @relation("ArticleCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  tags              Tag[]                @relation("ArticleToTag")
  translations      ArticleTranslation[]
  bookmarks         Bookmark[]
  slugHistory       ArticleSlugHistory[]

  @@index([sectionId])
  @@index([formatId])
  @@index([coverAssetId])
  @@index([archivedByActorId])
  @@map("articles")
}

/// Append-only registry: once a `(locale, slug)` pair is assigned to a material — via the initial
/// draft slug or `setSlug` (`translation/editor.ts`) — it is reserved forever, including after
/// permanent deletion (T-076, журнал §26.10, перенесено из AC-T053-2). `articleId` survives the
/// owning article only as a historical pointer: it is cleared, never the row itself.
model ArticleSlugHistory {
  locale    Locale
  slug      String
  articleId String?
  createdAt DateTime @default(now())
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@id([locale, slug])
  @@index([articleId])
  @@map("article_slug_history")
}

model Job {
  id                 String         @id @default(uuid())
  kind               String
  status             JobStatus      @default(queued)
  objectType         String?
  objectId           String?
  parameters         Json?
  originRequestId    String?
  availableAt        DateTime       @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  cancelledAt        DateTime?
  attemptCount       Int            @default(0)
  maxAttempts        Int            @default(3)
  manualRetryAllowed Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  attempts           JobAttempt[]
  aiProcesses        AiProcess[]
  mailMessages       MailMessage[]
  backendErrors      BackendError[]
  accountExport      AccountExport?

  @@index([status, availableAt])
  @@index([kind, status])
  @@index([objectType, objectId])
  @@index([originRequestId])
  @@map("jobs")
}

/// Подготовленная пользовательская выгрузка. Архив хранится в ObjectStorage не дольше семи дней;
/// строка сохраняет историю запросов и состояние фонового задания (`30-account/reader/export.md`).
model AccountExport {
  id          String    @id @default(uuid())
  userId      String
  jobId       String    @unique
  scope       Json
  storageKey  String?   @unique
  sizeBytes   Int?
  readyAt     DateTime?
  expiresAt   DateTime?
  requestedAt DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("account_exports")
}

model JobAttempt {
  id             String    @id @default(uuid())
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  number         Int
  status         JobStatus @default(queued)
  startedAt      DateTime?
  finishedAt     DateTime?
  errorRequestId String?
  errorClass     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([jobId, number])
  @@index([status])
  @@map("job_attempts")
}

model AiProcess {
  id                  String          @id @default(uuid())
  jobId               String?
  job                 Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  kind                AiProcessKind
  status              AiProcessStatus @default(created)
  objectType          String
  objectId            String
  /// Ревизия подачи для проверки статьи (T-048): аудит `ai.decision` (реестр #71) называет её
  /// рядом с версией. У проверки профиля и описания изображения ревизии нет — там NULL.
  revisionId          String?
  model               String?
  promptVersion       String?
  verdict             String?
  reasons             Json?
  /// Фрагменты подачи, на которых основан отказ: видят `moderator`/`reviewer` и `owner`
  /// (`40-admin/ai-check-criteria.md` §5).
  evidence            Json?
  /// Попытка манипулировать проверкой (журнал §43 п. 2): пометка ревьюеру, не текст автору.
  manipulationAttempt Boolean         @default(false)
  /// Пометка 18+ по решению проверки (журнал §43 п. 8): сама по себе не отказ.
  adult               Boolean         @default(false)
  providerErrorClass  String?
  startedAt           DateTime?
  finishedAt          DateTime?
  durationMs          Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  /// Одна проверка на ревизию: повторного запуска ради другого вердикта нет (журнал #14).
  /// Ограничение действует только на записи с ревизией — NULL в PostgreSQL не конфликтует.
  @@unique([objectType, objectId, revisionId])
  @@index([kind, status, createdAt])
  @@index([objectType, objectId])
  @@index([jobId])
  @@map("ai_processes")
}

/// Стоимость хранится только в агрегатах по периодам, но не у отдельного AI-процесса.
model AiCostAggregate {
  id             String        @id @default(uuid())
  bucketStart    DateTime
  bucketEnd      DateTime
  kind           AiProcessKind
  totalCostMinor BigInt
  processCount   Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([bucketStart, bucketEnd, kind])
  @@index([kind, bucketStart])
  @@map("ai_cost_aggregates")
}

model MailMessage {
  id                 String              @id @default(uuid())
  jobId              String?
  job                Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  template           String
  recipientEmail     String
  subject            String
  sanitizedBody      String              @db.Text
  status             MailDeliveryStatus  @default(queued)
  objectType         String?
  objectId           String?
  provider           String?
  messageId          String?
  deliveryErrorClass String?
  queuedAt           DateTime            @default(now())
  sentAt             DateTime?
  // Отметка повтора из админки: заявка на повтор и проверка «уже повторено» — один
  // условный UPDATE, поэтому два параллельных повтора дают одну отправку (T-134 §5 AC-4).
  resentAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deliveryEvents     MailDeliveryEvent[]

  @@index([status, createdAt])
  @@index([template, createdAt])
  @@index([recipientEmail])
  @@index([objectType, objectId])
  @@index([jobId])
  @@map("mail_messages")
}

model MailDeliveryEvent {
  id              String             @id @default(uuid())
  mailMessageId   String
  mailMessage     MailMessage        @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)
  status          MailDeliveryStatus
  providerEventId String?
  errorClass      String?
  occurredAt      DateTime           @default(now())

  @@index([mailMessageId, occurredAt])
  @@map("mail_delivery_events")
}

model BackendError {
  id                String                      @id @default(uuid())
  signature         String                      @unique
  service           BackendErrorService
  code              String
  errorClass        String?
  sanitizedMessage  String
  route             String?
  requestMethod     String?
  requestId         String?
  sanitizedStack    String?                     @db.Text
  actorRole         Role?
  jobId             String?
  job               Job?                        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  workStatus        BackendErrorWorkStatus      @default(new_record)
  assignedActorId   String?
  assignedActorRole Role?
  firstSeenAt       DateTime                    @default(now())
  lastSeenAt        DateTime                    @default(now())
  occurrenceCount   Int                         @default(1)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  statusHistory     BackendErrorStatusHistory[]

  @@index([workStatus, lastSeenAt])
  @@index([service, code])
  @@index([requestId])
  @@index([jobId])
  @@map("backend_errors")
}

model BackendErrorStatusHistory {
  id                 String                  @id @default(uuid())
  backendErrorId     String
  backendError       BackendError            @relation(fields: [backendErrorId], references: [id], onDelete: Cascade)
  fromStatus         BackendErrorWorkStatus?
  toStatus           BackendErrorWorkStatus
  changedByActorId   String
  changedByActorRole Role?
  comment            String?
  createdAt          DateTime                @default(now())

  @@index([backendErrorId, createdAt])
  @@map("backend_error_status_history")
}

/// Append-only история смен состояния `/health` для раздела админки T-081. JSON содержит только
/// публичный контракт health: имена адаптеров, статусы, задержки и возраст копий — без настроек.
model SystemHealthSnapshot {
  id         String   @id @default(uuid())
  status     String
  signature  String
  components Json
  backups    Json
  checkedAt  DateTime
  createdAt  DateTime @default(now())

  @@index([checkedAt])
  @@map("system_health_snapshots")
}

model LegalText {
  id                 String             @id @default(uuid())
  kind               LegalTextKind
  locale             Locale
  version            Int
  status             LegalTextStatus    @default(draft)
  body               String             @db.Text
  summaryOfChanges   String
  isMaterial         Boolean            @default(false)
  publishedAt        DateTime?
  publishedByActorId String?
  publishedByRole    Role?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  consents           UserLegalConsent[]

  @@unique([kind, locale, version])
  @@index([kind, locale, status])
  @@map("legal_texts")
}

model UserLegalConsent {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalTextId String
  legalText   LegalText @relation(fields: [legalTextId], references: [id], onDelete: Restrict)
  acceptedAt  DateTime  @default(now())

  @@unique([userId, legalTextId])
  @@index([legalTextId, acceptedAt])
  @@map("user_legal_consents")
}

model ArticleTranslation {
  id                 String            @id @default(uuid())
  articleId          String
  locale             Locale
  slug               String
  title              String
  dek                String?
  excerpt            String?
  featuredImage      String?
  body               Json
  status             ArticleStatus     @default(draft)
  rejected           Boolean           @default(false)
  publishedAt        DateTime?
  /// Точное число квалифицированных прочтений из контура вовлечённости. Порог и приём событий
  /// задаются отдельной спецификацией; очередь ревью только читает сохранённый агрегат (§26.4).
  readCount          Int               @default(0)
  /// Закрепление ручной проверки. Идентификатор хранится без relation намеренно: удаление или
  /// архив сотрудника не должно менять историческое состояние материала.
  reviewerId         String?
  reviewerRole       Role?
  reviewClaimedAt    DateTime?
  reeditUntil        DateTime?
  reeditedAt         DateTime?
  /// Токен ссылки из письма о доработке или снятии с публикации (`routes.md` #68). Срок и то,
  /// что новое решение заменяет прежний токен — [ДОПУЩЕНИЕ] (`moderation.md` §8,
  /// `write-and-publish.md` §8): семь дней, один активный токен на версию.
  editTokenHash      String?           @unique @db.VarChar(64)
  editTokenExpiresAt DateTime?
  translatorId       String?
  sourceRevisionId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  article            Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  translator         User?             @relation("ArticleTranslator", fields: [translatorId], references: [id], onDelete: SetNull)
  sourceRevision     ArticleRevision?  @relation("TranslationSourceRevision", fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  revisions          ArticleRevision[] @relation("TranslationRevisions")
  reviewMessages     ReviewMessage[]

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@index([status, publishedAt])
  @@index([status, reviewerId, updatedAt])
  @@index([translatorId])
  @@index([sourceRevisionId])
  @@map("article_translations")
}

model ArticleRevision {
  id                 String               @id @default(uuid())
  translationId      String
  title              String
  dek                String?
  excerpt            String?
  body               Json
  kind               ArticleRevisionKind
  createdById        String
  note               String?
  restoredFromId     String?
  createdAt          DateTime             @default(now())
  translation        ArticleTranslation   @relation("TranslationRevisions", fields: [translationId], references: [id], onDelete: Cascade)
  createdBy          User                 @relation("ArticleRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  restoredFrom       ArticleRevision?     @relation("RestoredArticleRevision", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restoredRevisions  ArticleRevision[]    @relation("RestoredArticleRevision")
  sourceTranslations ArticleTranslation[] @relation("TranslationSourceRevision")
  reviewNotes        ReviewNote[]

  @@index([translationId, createdAt])
  @@index([createdById])
  @@index([restoredFromId])
  @@map("article_revisions")
}

model MediaAsset {
  id                  String                @id @default(uuid())
  ownerId             String
  kind                MediaKind             @default(image)
  processingStatus    MediaProcessingStatus @default(uploading)
  storageKey          String                @unique
  mimeType            String
  byteSize            Int
  width               Int?
  height              Int?
  sha256              String
  variants            Json                  @default("[]")
  focalX              Float?
  focalY              Float?
  alt                 String?
  caption             String?
  attribution         String
  license             MediaLicense
  licenseNote         String?
  placeholder         String?
  deletedAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  owner               User                  @relation("MediaAssetOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  currentAvatarUsers  User[]                @relation("CurrentAvatar")
  previousAvatarUsers User[]                @relation("PreviousAvatar")
  coverArticles       Article[]             @relation("ArticleCover")

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([sha256])
  @@index([processingStatus, createdAt])
  @@map("media_assets")
}

/// Append-only audit journal. UPDATE and DELETE are blocked by DB triggers.
model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String?
  actorRole  Role?
  entityType String
  entityId   String
  diff       Json?
  subject    String?
  context    String?
  purpose    String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ReviewMessage {
  id              String             @id @default(uuid())
  translationId   String
  kind            ReviewMessageKind
  text            String?
  recommendations String?
  /// NULL — запись автоматической проверки (`ai_decision`): решение принимает система, роли
  /// сотрудника у такой записи нет (журнал §16.3; `30-account/author/review-history.md` §3).
  byRole          Role?
  parentId        String?
  readAt          DateTime?
  createdAt       DateTime           @default(now())
  translation     ArticleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  parent          ReviewMessage?     @relation("ReviewMessageThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies         ReviewMessage[]    @relation("ReviewMessageThread")

  @@index([translationId, createdAt])
  @@index([parentId])
  @@map("review_messages")
}

model ReviewNote {
  id          String          @id @default(uuid())
  revisionId  String
  blockId     String
  text        String
  createdById String
  resolved    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  revision    ArticleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("ReviewNoteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([revisionId])
  @@map("review_notes")
}

model Bookmark {
  userId                String
  articleId             String
  ownerRole             Role     @default(reader)
  ownerIsServiceAccount Boolean  @default(false)
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId, ownerRole, ownerIsServiceAccount], references: [id, role, isServiceAccount], onDelete: Cascade, onUpdate: Cascade)
  article               Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
}

model PlanGrant {
  id          String    @id @default(uuid())
  userId      String
  tier        PlanTier
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  grantedById String?
  reason      String
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("PlanGrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("PlanGrantActor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([userId, endsAt])
  @@map("plan_grants")
}

model PermissionException {
  id          String                  @id @default(uuid())
  userId      String
  role        Role
  permission  String
  kind        PermissionExceptionKind
  grantedById String
  reason      String
  startsAt    DateTime                @default(now())
  endsAt      DateTime?
  revokedAt   DateTime?
  revokedById String?
  expiredAt   DateTime?
  createdAt   DateTime                @default(now())
  user        User                    @relation("PermissionExceptionRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User                    @relation("PermissionExceptionGrantActor", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy   User?                   @relation("PermissionExceptionRevokeActor", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId, role, permission])
  @@index([endsAt, expiredAt])
  @@map("permission_exceptions")
}

/// Счётчики корзин лимитов частоты для режима без Redis (`docs/spec/50-access/rate-limits.md`
/// §2 п. 13, ADR-0019). Персональных данных нет: `key` — HMAC адреса, e-mail или аккаунта.
/// Строка живёт до конца своего окна, закрытые окна удаляет расписание API.
model RateLimitCounter {
  bucket    String
  key       String
  hits      Int      @default(0)
  expiresAt DateTime

  @@id([bucket, key])
  @@index([expiresAt])
  @@map("rate_limit_counters")
}

/// Обращение в поддержку и редакцию (`20-public/contact.md` §4, матрица #117): письмо с `/contact`
/// и «битая ссылка» со страницы 404 (журнал §20.15). Очередь в админке и статус в кабинете —
/// отдельные решения (Q-08), поэтому здесь только сама запись. Адрес отправителя — персональные
/// данные: в лог уходят только тема, шаблон маршрута и `requestId` (событие #80).
model SupportRequest {
  id                 String       @id @default(uuid())
  /// Номер обращения, который видит отправитель: «Обращение №{ticketNo} принято» (§5 зона 4).
  ticketNo           Int          @unique @default(autoincrement())
  topic              SupportTopic
  /// Адрес ответа; у анонимного сообщения о битой ссылке без комментария адреса нет.
  email              String?
  message            String?      @db.Text
  /// Страница, о которой обращение, без query-параметров (`contact.md` §3).
  path               String?
  /// `requestId` сбоя со страницы 500: ведёт сотрудника к записи ошибки (`request-tracing.md` п. 5).
  requestId          String?
  userId             String?
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  locale             Locale
  /// Запрос, которым обращение создано, — для сверки с логом `support.request.created`.
  createdByRequestId String
  createdAt          DateTime     @default(now())
  /// Отметка ответа сотрудника: `null` — «принято», дата — «отвечено» (журнал §37 п. 2).
  /// Второго поля статуса нет: один факт — один источник правды.
  answeredAt         DateTime?
  answeredById       String?
  answeredBy         User?        @relation("SupportRequestAnswer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([answeredAt])
  @@map("support_requests")
}

