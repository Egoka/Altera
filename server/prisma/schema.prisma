generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique
  bio                String?
  photoUrl           String?
  role               Role                 @default(reader)
  handle             String               @unique
  locale             Locale               @default(ru)
  avatarAssetId      String?
  prevAvatarId       String?
  nameCheckStatus    ProfileCheckStatus   @default(ok)
  avatarCheckStatus  ProfileCheckStatus   @default(ok)
  socialLinks        Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  archivedAt         DateTime?
  archiveMode        AccountArchiveMode?
  archivedByActorId  String?
  archivedByRole     Role?
  archiveReason      String?
  isServiceAccount   Boolean              @default(false)
  planTier           PlanTier             @default(free)
  planUntil          DateTime?
  articles           Article[]
  bookmarks          Bookmark[]
  planGrants         PlanGrant[]          @relation("PlanGrantRecipient")
  grantedPlanGrants  PlanGrant[]          @relation("PlanGrantActor")
  magicLink          MagicLinkToken?
  sessions           Session[]
  emailChangeRequest EmailChangeRequest?
  currentHandle      HandleHistory        @relation("CurrentUserHandle", fields: [handle], references: [handle], onDelete: Restrict, onUpdate: Restrict)
  handleHistory      HandleHistory[]      @relation("HandleOwner")
  createdTags        Tag[]                @relation("TagCreator")
  legalConsents      UserLegalConsent[]
  translatedArticles ArticleTranslation[] @relation("ArticleTranslator")
  articleRevisions   ArticleRevision[]    @relation("ArticleRevisionCreator")
  ownedMediaAssets   MediaAsset[]         @relation("MediaAssetOwner")
  avatarAsset        MediaAsset?          @relation("CurrentAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  previousAvatar     MediaAsset?          @relation("PreviousAvatar", fields: [prevAvatarId], references: [id], onDelete: SetNull)

  @@index([nameCheckStatus])
  @@index([avatarCheckStatus])
  @@map("users")
}

/// Append-only registry: issued handles are never deleted or reused.
model HandleHistory {
  handle      String   @id
  userId      String?
  user        User?    @relation("HandleOwner", fields: [userId], references: [id], onDelete: SetNull)
  currentUser User?    @relation("CurrentUserHandle")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("handle_history")
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.VarChar(64)
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("magic_link_tokens")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @db.VarChar(64)
  previousTokenHash String?   @db.VarChar(64)
  expiresAt         DateTime
  revokedAt         DateTime?
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  @@index([userId])
  @@index([previousTokenHash])
  @@map("sessions")
}

model EmailChangeRequest {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  codeHash  String   @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_change_requests")
}

model Section {
  id                    String               @id @default(uuid())
  name                  String
  nameEn                String?
  slug                  String               @unique
  description           String?
  descriptionEn         String?
  seoTitle              String?
  seoTitleEn            String?
  seoDescription        String?
  seoDescriptionEn      String?
  order                 Int
  status                TaxonomyStatus       @default(active)
  successorId           String?
  archivedAt            DateTime?
  archivedByActorId     String?
  archivedByRole        Role?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  articles              Article[]
  successor             Section?             @relation("SectionSuccessor", fields: [successorId], references: [id], onDelete: Restrict)
  predecessors          Section[]            @relation("SectionSuccessor")
  currentSlug           SectionSlugHistory   @relation("CurrentSectionSlug", fields: [slug], references: [slug], onDelete: Restrict, onUpdate: Restrict)
  slugHistory           SectionSlugHistory[] @relation("SectionSlugOwner")
  redirectedSlugHistory SectionSlugHistory[] @relation("SectionSlugRedirect")

  @@index([status, order])
  @@index([successorId])
  @@map("sections")
}

/// Append-only registry: issued section slugs are never deleted or reused.
model SectionSlugHistory {
  slug                String   @id
  ownerSectionId      String?
  redirectToSectionId String?
  createdAt           DateTime @default(now())
  ownerSection        Section? @relation("SectionSlugOwner", fields: [ownerSectionId], references: [id], onDelete: SetNull)
  redirectToSection   Section? @relation("SectionSlugRedirect", fields: [redirectToSectionId], references: [id], onDelete: SetNull)
  currentSection      Section? @relation("CurrentSectionSlug")

  @@index([ownerSectionId])
  @@index([redirectToSectionId])
  @@map("section_slug_history")
}

model Format {
  id            String         @id @default(uuid())
  name          String
  nameEn        String?
  slug          String         @unique
  description   String?
  descriptionEn String?
  status        TaxonomyStatus @default(active)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  articles      Article[]

  @@index([status])
  @@map("formats")
}

model Tag {
  id                    String           @id @default(uuid())
  name                  String
  nameEn                String?
  slug                  String           @unique
  description           String?
  status                TaxonomyStatus   @default(active)
  mergedIntoId          String?
  createdByActorId      String?
  createdByRole         Role?
  archivedAt            DateTime?
  archivedByActorId     String?
  archivedByRole        Role?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  articles              Article[]        @relation("ArticleToTag")
  creator               User?            @relation("TagCreator", fields: [createdByActorId], references: [id], onDelete: SetNull)
  mergedInto            Tag?             @relation("TagMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom            Tag[]            @relation("TagMerge")
  currentSlug           TagSlugHistory   @relation("CurrentTagSlug", fields: [slug], references: [slug], onDelete: Restrict, onUpdate: Restrict)
  slugHistory           TagSlugHistory[] @relation("TagSlugOwner")
  redirectedSlugHistory TagSlugHistory[] @relation("TagSlugRedirect")

  @@index([status])
  @@index([mergedIntoId])
  @@index([createdByActorId])
  @@map("tags")
}

/// Append-only registry: issued tag slugs are never deleted or reused.
model TagSlugHistory {
  slug            String   @id
  ownerTagId      String?
  redirectToTagId String?
  createdAt       DateTime @default(now())
  ownerTag        Tag?     @relation("TagSlugOwner", fields: [ownerTagId], references: [id], onDelete: SetNull)
  redirectToTag   Tag?     @relation("TagSlugRedirect", fields: [redirectToTagId], references: [id], onDelete: SetNull)
  currentTag      Tag?     @relation("CurrentTagSlug")

  @@index([ownerTagId])
  @@index([redirectToTagId])
  @@map("tag_slug_history")
}

model Article {
  id                String               @id @default(uuid())
  // Старые локализованные поля остаются до T-020 и перевода API на языковые версии.
  title             String
  slug              String               @unique
  dek               String?
  body              String
  excerpt           String?
  featuredImage     String?
  status            ArticleStatus        @default(draft)
  publishedAt       DateTime?
  sourceLocale      Locale               @default(ru)
  isEditorial       Boolean              @default(false)
  firstPublishedAt  DateTime?
  archivedAt        DateTime?
  archivedByActorId String?
  archivedByRole    Role?
  archiveReason     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  authorId          String
  sectionId         String?
  formatId          String?
  coverAssetId      String?
  author            User                 @relation(fields: [authorId], references: [id])
  section           Section?             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  format            Format?              @relation(fields: [formatId], references: [id], onDelete: SetNull)
  coverAsset        MediaAsset?          @relation("ArticleCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  tags              Tag[]                @relation("ArticleToTag")
  translations      ArticleTranslation[]
  bookmarks         Bookmark[]

  @@index([sectionId])
  @@index([formatId])
  @@index([coverAssetId])
  @@index([archivedByActorId])
  @@map("articles")
}

model Job {
  id            String         @id @default(uuid())
  kind          String
  status        JobStatus      @default(queued)
  objectType    String?
  objectId      String?
  parameters    Json?
  availableAt   DateTime       @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  cancelledAt   DateTime?
  attemptCount  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  attempts      JobAttempt[]
  aiProcesses   AiProcess[]
  mailMessages  MailMessage[]
  backendErrors BackendError[]

  @@index([status, availableAt])
  @@index([kind, status])
  @@index([objectType, objectId])
  @@map("jobs")
}

model JobAttempt {
  id             String    @id @default(uuid())
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  number         Int
  status         JobStatus @default(queued)
  startedAt      DateTime?
  finishedAt     DateTime?
  errorRequestId String?
  errorClass     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([jobId, number])
  @@index([status])
  @@map("job_attempts")
}

model AiProcess {
  id                 String          @id @default(uuid())
  jobId              String?
  job                Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  kind               AiProcessKind
  status             AiProcessStatus @default(created)
  objectType         String
  objectId           String
  model              String?
  promptVersion      String?
  verdict            String?
  reasons            Json?
  providerErrorClass String?
  startedAt          DateTime?
  finishedAt         DateTime?
  durationMs         Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([kind, status, createdAt])
  @@index([objectType, objectId])
  @@index([jobId])
  @@map("ai_processes")
}

/// Стоимость хранится только в агрегатах по периодам, но не у отдельного AI-процесса.
model AiCostAggregate {
  id             String        @id @default(uuid())
  bucketStart    DateTime
  bucketEnd      DateTime
  kind           AiProcessKind
  totalCostMinor BigInt
  processCount   Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([bucketStart, bucketEnd, kind])
  @@index([kind, bucketStart])
  @@map("ai_cost_aggregates")
}

model MailMessage {
  id                 String              @id @default(uuid())
  jobId              String?
  job                Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  template           String
  recipientEmail     String
  subject            String
  sanitizedBody      String              @db.Text
  status             MailDeliveryStatus  @default(queued)
  objectType         String?
  objectId           String?
  provider           String?
  messageId          String?
  deliveryErrorClass String?
  queuedAt           DateTime            @default(now())
  sentAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deliveryEvents     MailDeliveryEvent[]

  @@index([status, createdAt])
  @@index([template, createdAt])
  @@index([recipientEmail])
  @@index([objectType, objectId])
  @@index([jobId])
  @@map("mail_messages")
}

model MailDeliveryEvent {
  id              String             @id @default(uuid())
  mailMessageId   String
  mailMessage     MailMessage        @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)
  status          MailDeliveryStatus
  providerEventId String?
  errorClass      String?
  occurredAt      DateTime           @default(now())

  @@index([mailMessageId, occurredAt])
  @@map("mail_delivery_events")
}

model BackendError {
  id                String                      @id @default(uuid())
  signature         String                      @unique
  service           BackendErrorService
  code              String
  errorClass        String?
  sanitizedMessage  String
  route             String?
  requestMethod     String?
  requestId         String?
  sanitizedStack    String?                     @db.Text
  actorRole         Role?
  jobId             String?
  job               Job?                        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  workStatus        BackendErrorWorkStatus      @default(new_record)
  assignedActorId   String?
  assignedActorRole Role?
  firstSeenAt       DateTime                    @default(now())
  lastSeenAt        DateTime                    @default(now())
  occurrenceCount   Int                         @default(1)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  statusHistory     BackendErrorStatusHistory[]

  @@index([workStatus, lastSeenAt])
  @@index([service, code])
  @@index([requestId])
  @@index([jobId])
  @@map("backend_errors")
}

model BackendErrorStatusHistory {
  id                 String                  @id @default(uuid())
  backendErrorId     String
  backendError       BackendError            @relation(fields: [backendErrorId], references: [id], onDelete: Cascade)
  fromStatus         BackendErrorWorkStatus?
  toStatus           BackendErrorWorkStatus
  changedByActorId   String
  changedByActorRole Role
  comment            String?
  createdAt          DateTime                @default(now())

  @@index([backendErrorId, createdAt])
  @@map("backend_error_status_history")
}

model LegalText {
  id                 String             @id @default(uuid())
  kind               LegalTextKind
  locale             Locale
  version            Int
  status             LegalTextStatus    @default(draft)
  body               String             @db.Text
  summaryOfChanges   String
  isMaterial         Boolean            @default(false)
  publishedAt        DateTime?
  publishedByActorId String?
  publishedByRole    Role?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  consents           UserLegalConsent[]

  @@unique([kind, locale, version])
  @@index([kind, locale, status])
  @@map("legal_texts")
}

model UserLegalConsent {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalTextId String
  legalText   LegalText @relation(fields: [legalTextId], references: [id], onDelete: Restrict)
  acceptedAt  DateTime  @default(now())

  @@unique([userId, legalTextId])
  @@index([legalTextId, acceptedAt])
  @@map("user_legal_consents")
}

model ArticleTranslation {
  id               String            @id @default(uuid())
  articleId        String
  locale           Locale
  slug             String
  title            String
  dek              String?
  excerpt          String?
  featuredImage    String?
  body             Json
  status           ArticleStatus     @default(draft)
  rejected         Boolean           @default(false)
  publishedAt      DateTime?
  reeditUntil      DateTime?
  reeditedAt       DateTime?
  translatorId     String?
  sourceRevisionId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  article          Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  translator       User?             @relation("ArticleTranslator", fields: [translatorId], references: [id], onDelete: SetNull)
  sourceRevision   ArticleRevision?  @relation("TranslationSourceRevision", fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  revisions        ArticleRevision[] @relation("TranslationRevisions")

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@index([status, publishedAt])
  @@index([translatorId])
  @@index([sourceRevisionId])
  @@map("article_translations")
}

model ArticleRevision {
  id                 String               @id @default(uuid())
  translationId      String
  title              String
  dek                String?
  excerpt            String?
  body               Json
  kind               ArticleRevisionKind
  createdById        String
  note               String?
  restoredFromId     String?
  createdAt          DateTime             @default(now())
  translation        ArticleTranslation   @relation("TranslationRevisions", fields: [translationId], references: [id], onDelete: Cascade)
  createdBy          User                 @relation("ArticleRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  restoredFrom       ArticleRevision?     @relation("RestoredArticleRevision", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restoredRevisions  ArticleRevision[]    @relation("RestoredArticleRevision")
  sourceTranslations ArticleTranslation[] @relation("TranslationSourceRevision")

  @@index([translationId, createdAt])
  @@index([createdById])
  @@index([restoredFromId])
  @@map("article_revisions")
}

model MediaAsset {
  id                  String                @id @default(uuid())
  ownerId             String
  kind                MediaKind             @default(image)
  processingStatus    MediaProcessingStatus @default(uploading)
  storageKey          String                @unique
  mimeType            String
  byteSize            Int
  width               Int?
  height              Int?
  sha256              String
  variants            Json                  @default("[]")
  focalX              Float?
  focalY              Float?
  alt                 String?
  caption             String?
  attribution         String
  license             MediaLicense
  licenseNote         String?
  placeholder         String?
  deletedAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  owner               User                  @relation("MediaAssetOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  currentAvatarUsers  User[]                @relation("CurrentAvatar")
  previousAvatarUsers User[]                @relation("PreviousAvatar")
  coverArticles       Article[]             @relation("ArticleCover")

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([sha256])
  @@index([processingStatus, createdAt])
  @@map("media_assets")
}

model Bookmark {
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
}

model PlanGrant {
  id          String    @id @default(uuid())
  userId      String
  tier        PlanTier
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  grantedById String?
  reason      String
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("PlanGrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("PlanGrantActor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([userId, endsAt])
  @@map("plan_grants")
}

enum Role {
  reader
  author
  editor
  moderator
  analyst
  admin
  owner
}

enum PlanTier {
  free
  standard
  pro
}

enum AccountArchiveMode {
  self
  admin
  emergency
}

enum Locale {
  ru
  en
}

enum ProfileCheckStatus {
  ok
  pending
  rejected
}

enum TaxonomyStatus {
  active
  archived
}

enum ArticleStatus {
  draft
  ai_check
  review
  in_review
  rework
  published
  archived
}

enum JobStatus {
  queued
  running
  completed
  failed
  cancelled
  stuck
}

enum AiProcessKind {
  check
  translate
  profile
  alt
}

enum AiProcessStatus {
  created
  started
  running
  completed
  failed
}

enum MailDeliveryStatus {
  queued
  sent
  bounced
  failed
}

enum BackendErrorService {
  api
  web
  worker
}

enum BackendErrorWorkStatus {
  new_record  @map("new")
  in_progress
  resolved
}

enum LegalTextKind {
  terms
  privacy
  content_rules
  license
  paid_services
  refunds
  about
}

enum LegalTextStatus {
  draft
  published
  previous
}

enum ArticleRevisionKind {
  publish
  editorial
  manual
  autosave
}

enum MediaKind {
  image
}

enum MediaProcessingStatus {
  uploading
  queued
  processing
  ready
  failed
}

enum MediaLicense {
  own
  cc_by
  cc_by_sa
  cc_by_nc
  cc0
  public_domain
  permission
}
