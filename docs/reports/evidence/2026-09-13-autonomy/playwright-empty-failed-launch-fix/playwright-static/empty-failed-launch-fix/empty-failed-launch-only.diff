+function observeProfileResidue(root = '/runtime/tmp') {
+  return fs.readdirSync(root).filter((name) => name.startsWith('playwright_chromiumdev_profile-')).sort().map((name) => {
+    const row = { name, type: 'unreadable', empty: false }
+    try {
+      const file = path.join(root, name), before = fs.lstatSync(file, { bigint: true })
+      row.type = before.isSymbolicLink() ? 'symlink' : before.isDirectory() ? 'directory' : before.isFile() ? 'file' : 'other'
+      row.dev = String(before.dev); row.ino = String(before.ino); row.mode = Number(before.mode & 0o777n); row.uid = Number(before.uid)
+      if (row.type === 'directory') {
+        row.empty = fs.readdirSync(file).length === 0
+        const after = fs.lstatSync(file, { bigint: true })
+        if (!after.isDirectory() || after.isSymbolicLink() || after.dev !== before.dev || after.ino !== before.ino ||
+            after.mtimeNs !== before.mtimeNs || after.ctimeNs !== before.ctimeNs) row.error = 'PROFILE_CHANGED'
+      }
+    } catch (error) { row.error = error.code || 'PROFILE_UNREADABLE' }
+    return row
+  })
+}
