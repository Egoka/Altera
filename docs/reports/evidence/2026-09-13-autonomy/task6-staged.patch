+            'native_outcome': report['native_outcome'], 'stage_outcome': 'completed', 'task_acceptance': 'not_checked'})
+        task['anchor'] = snap
+        task['last_owner'] = {'actor': slot['actor'], 'run': slot['run']}
+        slot['archives'] = archives
+        state['completed'][str(root)] = {'slot': slot}
+        state['slot'] = None
